    <!-- Sleep diary -->
    <string name="sleep_title">Dzienniczek snu</string>
    <string name="sleep_intro">Wypełniaj rano, gdy noc jest jeszcze świeża w pamięci. Wystarczą przybliżone godziny. Po kilku nocach zobaczysz, ile śpisz i jaka jest efektywność snu.</string>
