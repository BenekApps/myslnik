    <!-- Exposure -->
    <string name="exposure_title">Drabina ekspozycji</string>
    <string name="exposure_intro">Unikanie zmniejsza lęk na chwilę, ale na dłuższą metę go utrwala. Drabina to lista sytuacji od najłatwiejszej do najtrudniejszej. Zaczynasz od dołu i idziesz w górę we własnym tempie. Najlepiej robić to z terapeutą.</string>
    <string name="exposure_new_ladder">Nowa drabina</string>
    <string name="exposure_ladder_label">Czego dotyczy?</string>
    <string name="exposure_ladder_hint">Na przykład: jazda autobusem, rozmowy przez telefon, wychodzenie z domu.</string>
    <string name="exposure_empty">Nie masz jeszcze żadnej drabiny.</string>
    <string name="exposure_steps_count">Kroki: %1$d</string>
    <string name="exposure_ladder_intro">Dodaj kilka sytuacji i oceń, jak duży lęk przewidujesz (0–100). Drabina ułoży je od najłatwiejszej.</string>
    <string name="exposure_add_step">Dodaj krok</string>
    <string name="exposure_no_steps">Dodaj pierwszy krok, na przykład coś, co budzi lęk około 20–30.</string>
    <string name="exposure_steps_title">Kroki od najłatwiejszego</string>
    <string name="exposure_attempts_count">Próby: %1$d</string>
    <string name="exposure_last_attempt">ostatnio %1$d → %2$d</string>
    <string name="exposure_expected_legend">Liczba po lewej to przewidywany lęk od 0 do 100.</string>
    <string name="exposure_rename">Zmień nazwę</string>
    <string name="exposure_delete_ladder">Usunąć tę drabinę?</string>
    <string name="exposure_delete_ladder_text">Znikną też wszystkie jej kroki i próby. Tego nie da się cofnąć.</string>
    <string name="exposure_step_dialog_title">Krok</string>
    <string name="exposure_step_label">Sytuacja</string>
    <string name="exposure_expected">Przewidywany lęk</string>
    <string name="exposure_step_title">Krok drabiny</string>
    <string name="exposure_expected_value">Przewidywany lęk: %1$d/100</string>
    <string name="exposure_step_hint">Zostań w sytuacji, aż lęk zacznie spadać, bez zachowań, które go szybko gaszą. Zapisz lęk tuż przed i tuż po. Gdy po kilku próbach jest wyraźnie niższy, możesz przejść wyżej.</string>
