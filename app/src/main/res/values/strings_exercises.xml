    <!-- Problem solving -->
    <string name="problems_title">Rozwiązywanie problemów</string>
    <string name="problems_title_single">Problem</string>
    <string name="problems_intro">Gdy problem wydaje się za duży, pomaga rozłożenie go na kroki: nazwać go, zebrać pomysły, porównać je i wybrać jeden do sprawdzenia.</string>
    <string name="problems_new">Nowy problem</string>
