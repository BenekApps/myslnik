    <!-- Worry time -->
    <string name="worry_title">Czas na zamartwianie się</string>
    <string name="worry_intro">Zamartwianie się przez cały dzień męczy i rzadko coś rozwiązuje. Spróbuj odkładać zmartwienia na jedną, stałą porę. Gdy pojawi się zmartwienie, zapisz je krótko i wróć do tego, co robisz.</string>
    <string name="worry_time_label">Twój czas na zamartwianie się</string>
    <string name="worry_time_hint">Około 15 minut, najlepiej nie tuż przed snem. Przypomnienie włączysz w ustawieniach.</string>
