    <string name="problems_delete_title">Usunąć ten problem?</string>
    <string name="problem_step_define_title">Jaki to problem?</string>
    <string name="problem_step_define_hint">Opisz go konkretnie: co się dzieje, kiedy i co chcesz zmienić. Jeśli problem jest duży, wybierz jedną jego część.</string>
    <string name="problem_step_solutions_title">Jakie są możliwe rozwiązania?</string>
    <string name="problem_step_solutions_hint">Zapisz wszystko, co przychodzi Ci do głowy, nawet dziwne pomysły. Na razie niczego nie oceniaj.</string>
    <string name="problem_step_pros_cons_title">Plusy i minusy</string>
    <string name="problem_step_pros_cons_hint">Przy każdym pomyśle zapisz, co przemawia za nim, a co przeciw. Weź pod uwagę koszt, czas i to, jak się z tym poczujesz.</string>
    <string name="problem_step_choose_title">Które rozwiązanie wybierasz?</string>
    <string name="problem_step_choose_hint">Wybierz jedno do sprawdzenia. Nie musi być idealne.</string>
    <string name="problem_step_plan_title">Jak to zrobisz?</string>
    <string name="problem_step_plan_hint">Rozpisz małe kroki: co, kiedy, czego potrzebujesz i kto może pomóc.</string>
    <string name="problem_step_review_title">Jak poszło?</string>
    <string name="problem_step_review_hint">Uzupełnij po spróbowaniu. Jeśli nie zadziałało, możesz wrócić i wybrać inne rozwiązanie.</string>
