    <string name="sleep_summary_sleep">Średni czas snu: %1$s</string>
    <string name="sleep_summary_efficiency">Średnia efektywność snu: %1$d%%</string>
    <string name="sleep_efficiency_explained">Efektywność snu to część czasu w łóżku, którą przesypiasz. Na przykład 7 godzin snu przy 8 godzinach w łóżku to około 88 procent.</string>
